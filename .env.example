# Copy this file to .env and adjust for your machine.
#   cp .env.example .env
# .env is gitignored (never committed); this template is.
# Real shell environment variables override anything set here.

# Where your course files live — one folder per module (cs5224/, cs5228/, ...).
NUS_DATA_ROOT=/path/to/your/course/files

# --- LLM provider (optional; defaults shown) ---
# ollama (local, default) | anthropic | openai
# NUS_LLM_PROVIDER=ollama
# NUS_LLM_MODEL=qwen3:8b

# --- Cloud provider keys (only if you switch off the local ollama default) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
