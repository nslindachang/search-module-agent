# Local settings / secrets (machine-specific paths, API keys)
# .env is ignored; .env.example is committed as a template.
.env

# Working data (regenerated by build_index / rendering)
.cache/
.chroma/
snapshots/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Local pyenv-virtualenv binding (machine-specific venv name; not portable).
# Python version requirement is documented in the README instead.
.python-version

# macOS
.DS_Store

# Claude Code local settings (personal; shared .claude/ config can still be committed)
.claude/settings.local.json
